{
	"compilerOptions": {
		"target": "ES2019",
		"module": "ESNext",
		"lib": ["ES2019", "DOM"],
		"strict": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"resolvePackageJsonExports": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"outDir": "./dist",
		"rootDir": "./src",
		"types": ["obsidian"],
		"typeRoots": ["node_modules/@types", "node_modules"]
	},
	"include": ["src/**/*.ts"]
}
