{
	"compilerOptions": {
		"target": "ES6",
		"module": "ESNext",
		"lib": ["ES6", "ES2016", "DOM"], // 添加 ES2016
		"strict": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"resolvePackageJsonExports": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"outDir": "./dist",
		"rootDir": "./src"
	},
	"include": ["src/**/*.ts", "src/process/config/config.ts"]
}
