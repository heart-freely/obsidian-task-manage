{
	"compilerOptions": {
		"target": "ES2018",
		"module": "ESNext",
		"lib": ["ES2018", "DOM"],
		"strict": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"resolvePackageJsonExports": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"outDir": "./dist",
		"rootDir": "./src"
	},
	"include": ["src/**/*.ts"]
}
